# Copie para .env e troque a senha. O .env nunca vai para o Git.

# PostgreSQL: nomes PG* são lidos nativamente pelo driver "pg".
# localhost vale para scripts rodando na sua máquina (laboratório);
# dentro do Docker Compose, a API usará o nome do serviço como host.
PGHOST=localhost
PGPORT=5432
PGUSER=orderflow
PGPASSWORD=troque-esta-senha
PGDATABASE=orderflow

# API
PORT=3000
LOG_LEVEL=info

# Origens do frontend autorizadas por CORS, separadas por vírgula, sem barra final
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
